# Radio Bot configuration. Copy to .env and fill in the first two values.
# Never commit .env — it contains your bot token.
# Booleans accept true/false (also 1/0, yes/no, on/off). Lists are comma- or space-separated.

# --- Required: from https://discord.com/developers/applications ---
DISCORD_TOKEN=replace-with-your-own-bot-token
DISCORD_APPLICATION_ID=replace-with-your-application-id

# Optional: register /radio only in this server (useful while testing). Empty = every server.
DISCORD_DEV_GUILD_ID=
# Register (or update) /radio in each server at start-up, and when the bot joins a server.
REGISTER_COMMANDS_ON_START=true

# --- Storage and logs ---
# SQLite file (default ./data/radio-bot.sqlite). The Docker image and compose.yaml set
# /app/data/radio-bot.sqlite and the systemd unit sets /var/lib/radio-bot/radio-bot.sqlite,
# so leave this commented out there (under systemd a value here would override the unit's).
# DATABASE_PATH=./data/radio-bot.sqlite
# fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# --- FFmpeg (the Docker image sets these; only needed outside Docker if not on PATH) ---
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# --- Station packs (see catalog/README.md) ---
# Radio Bot ships with no packs. Install them from the official pack library with `radio-bot packs`
# or /radio packs library; they are kept in the installed-packs folder next to the database.
# To load packs you wrote yourself, put their folders in a directory and name it here
# (in Docker, inside the data volume, e.g. /app/data/my-packs). Not the installed-packs folder.
EXTRA_PACKS_DIR=
# Pack IDs to switch off (DISABLED_PACKS), or to switch on when a pack is off by default
# (ENABLED_PACKS). If a pack is in both, DISABLED_PACKS wins.
DISABLED_PACKS=
ENABLED_PACKS=
# Check station names against each pack's official station list, for packs that have one
# (names only, never stream URLs), every N hours (6-720).
CATALOG_SYNC_ENABLED=true
CATALOG_SYNC_INTERVAL_HOURS=24
# Take stations or sources off the air on this installation, e.g. after a takedown request.
# Station IDs look like mypack:my-station.
DISABLED_STATION_IDS=
DISABLED_SOURCE_IDS=
# Discord user IDs (operators) allowed to record, with /radio source verify, whether a pack source
# plays the right station, and to install, update or remove station packs from Discord. These apply
# to every server. The application's owner (or team members) always can.
OPERATOR_USER_IDS=

# --- Audio ---
# Highest Opus bitrate sent to Discord (32-510 kbps). 'maximum' quality matches each station's own
# bitrate up to this limit (a 128 kbps station is sent at 128). Not limited by the voice channel's setting.
MAX_OPUS_BITRATE_KBPS=510

# --- Stream requests ---
# User-Agent for stream requests (max 300 characters). Empty = the installed FFmpeg's own
# (e.g. Lavf/61.7.100), which standard stream hosts accept. Override only if a host needs something else.
STREAM_USER_AGENT=

# --- Bot status ---
# What the bot's Discord status ("Listening to …") shows while it plays: track (station and
# song title), station (station name only) or off. A bot has one status for every server, so with
# several servers playing different stations it shows "radio in N servers". Custom stations are
# private to their server and are never named.
PRESENCE_MODE=track

# --- Defaults for new servers (each server can change them with /radio config) ---
# maximum, balanced or manual.
DEFAULT_QUALITY_MODE=maximum
# leave_when_empty, pause_when_empty or 24x7.
DEFAULT_IDLE_MODE=leave_when_empty
# Default for the "Resume after restart" setting.
AUTO_RESUME_DEFAULT=false

# --- Resource limits ---
# Servers streaming at once from this installation (1-1000).
MAX_ACTIVE_GUILD_STREAMS=3
# Source checks (probes) running at once (1-16).
MAX_CONCURRENT_PROBES=2
# Custom stations per server (0-500; 0 disables custom stations).
MAX_CUSTOM_STATIONS_PER_GUILD=25
# Probe results kept per source (1-1000) and their maximum age in days (1-365).
PROBE_HISTORY_LIMIT=30
PROBE_HISTORY_DAYS=30

# --- Safety ---
# Allow legacy http:// streams (shown with a warning). Set false to require https.
ALLOW_INSECURE_HTTP_STREAMS=true
# Radio Bot ships no telemetry; this must stay false (true is refused at start-up).
TELEMETRY_ENABLED=false
# Port (1-65535) for an optional diagnostics endpoint that only this machine can reach (127.0.0.1).
# Empty = off.
DIAGNOSTICS_PORT=
