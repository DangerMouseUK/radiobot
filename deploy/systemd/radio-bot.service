# Radio Bot — systemd unit for a bare-metal or VM Linux host.
# Install: see docs/install-linux.md. Assumes the app lives in /opt/radio-bot and its
# configuration in /etc/radio-bot/radio-bot.env (mode 0600, readable only by root).
[Unit]
Description=Radio Bot (Discord internet-radio bot)
Documentation=https://github.com/DangerMouseUK/radiobot/blob/main/docs/install-linux.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/radio-bot
EnvironmentFile=/etc/radio-bot/radio-bot.env
# Values from EnvironmentFile= take precedence over Environment= lines, so keep
# DATABASE_PATH out of radio-bot.env (it is commented out in .env.example).
Environment=NODE_ENV=production
Environment=DATABASE_PATH=/var/lib/radio-bot/radio-bot.sqlite
ExecStart=/usr/bin/node dist/src/index.js
# `systemctl reload radio-bot` loads station packs changed with dist/scripts/packs.js, without a restart.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
# Exit code 78 means the configuration is invalid; restarting won't help until it is fixed.
RestartPreventExitStatus=78
TimeoutStopSec=20
# Voice packets go out every 20 ms, so the bot (and the FFmpeg encoder it starts) gets the CPU ahead
# of everything else on a small host. systemd sets these before dropping privileges; stream checks
# still lower their own FFmpeg processes to the lowest priority, and raise their own OOM score.
# Nice ranks processes within one cgroup; CPUWeight ranks this service against other services
# (default 100). It is a share, never a limit: no CPUQuota= or MemoryMax=, which would stall the audio.
Nice=-5
CPUWeight=1000
# Disk access ahead of other services, where the kernel's I/O controller and disk scheduler support it.
IOWeight=1000
# If the host runs out of memory, the kernel stops other processes before the bot and its encoder.
OOMScoreAdjust=-500

# Runs as a throwaway system user; systemd creates /var/lib/radio-bot for its data.
DynamicUser=yes
StateDirectory=radio-bot
StateDirectoryMode=0750

# Hardening: the bot needs outbound network access, FFmpeg, and its state directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
