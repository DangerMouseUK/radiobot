#!/usr/bin/env bash
# Stand-in for the docker CLI in the lifecycle test: records each call and simulates one
# radio-bot container. FAKE_PULL_OK=1 makes `compose pull` succeed; FAKE_CRASH=1 makes the
# container restart-loop like a bot with a bad token. FAKE_COMPOSE_VERSION sets the reported version,
# and FAKE_PLAYING the number of servers the bot reports playing in. FAKE_UP_FAIL=1 makes `compose up`
# fail (an update interrupted before the restart) and FAKE_RUN_FAIL=1 makes `compose run` fail (a
# restore that can't copy the file). Local images are listed in $FAKE_STATE/images as
# "repository:tag id", one per line; pull and build add the checked-out version's.
st=$FAKE_STATE
echo "docker $*" >>"$st/calls.log"
now() { date -u +%Y-%m-%dT%H:%M:%S.000000000Z; }
running() { [ -f "$st/running" ]; }
REPO=ghcr.io/dangermouseuk/radio-bot
version() { git describe --tags --exact-match 2>/dev/null || echo dev; }
add_image() {
  touch "$st/images"
  grep -q "^$REPO:$(version) " "$st/images" || echo "$REPO:$(version) sha256:$(version)" >>"$st/images"
}
case "$1" in
  info) exit 0 ;;
  image)
    case "$2" in
      ls) grep -F "${*: -1}:" "$st/images" 2>/dev/null ;;
      rm) # by "repository:tag" or id; refused while the container uses it
        line=$(awk -v r="$3" '$1 == r || $2 == r' "$st/images" 2>/dev/null)
        if [ -z "$line" ] || [ "$line" = "$(cat "$st/current" 2>/dev/null)" ]; then exit 1; fi
        grep -vxF "$line" "$st/images" >"$st/images.new"
        mv "$st/images.new" "$st/images"
        ;;
    esac
    exit 0
    ;;
  inspect)
    running || [ -f "$st/stopped" ] || exit 1
    case "$3" in
      '{{.Config.Image}}') cut -d' ' -f1 "$st/current" ;;
      '{{.Image}}') cut -d' ' -f2 "$st/current" ;;
      '{{.State.Status}}') if running; then echo running; else echo exited; fi ;;
      '{{.State.StartedAt}}') cat "$st/started" ;;
      '{{.RestartCount}}')
        n=$(cat "$st/restarts" 2>/dev/null || echo 0)
        if [ -n "${FAKE_CRASH:-}" ]; then n=$((n + 1)) && echo "$n" >"$st/restarts"; fi
        echo "$n"
        ;;
    esac
    exit 0
    ;;
  cp) # docker cp works on a stopped container too
    running || [ -f "$st/stopped" ] || exit 1
    dest=${*: -1} && mkdir -p "$dest" && touch "$dest/radio-bot-manual-x.sqlite"
    exit 0
    ;;
  compose) shift ;;
  *) exit 2 ;;
esac
case "$1" in
  version) echo "Docker Compose version v${FAKE_COMPOSE_VERSION:-2.40.0}" ;;
  config) echo "$REPO:$(version)" ;; # --images: the image the checked-out compose.yaml names
  pull) [ -n "${FAKE_PULL_OK:-}" ] || { echo "manifest unknown" >&2 && exit 1; } && add_image ;;
  build) echo "(built)" && add_image ;;
  run) [ -z "${FAKE_RUN_FAIL:-}" ] || { echo "cp: cannot create regular file" >&2 && exit 1; } ;;
  up)
    [ -z "${FAKE_UP_FAIL:-}" ] || { echo "network error" >&2 && exit 1; }
    rm -f "$st/stopped" && touch "$st/running" && now >"$st/started"
    grep "^$REPO:$(version) " "$st/images" >"$st/current"
    ;;
  restart) now >"$st/started" ;;
  stop) rm -f "$st/running" && touch "$st/stopped" ;;
  down) rm -f "$st/running" "$st/stopped" ;;
  exec)
    case "$*" in
      *backup.js*) echo "Backup written: /app/data/backups/radio-bot-manual-x.sqlite" ;;
      *"packs.js count"*) cat "$st/packs" 2>/dev/null || echo 0 ;;
      *"packs.js browse"*) echo "Packs in the official pack library:" && echo "  mypack  My Pack · 3 stations" ;;
      *"packs.js add"*) echo "Installed My Pack (mypack): 3 stations." && echo 1 >"$st/packs" ;;
      *packs.js*) echo "(packs)" ;;
      *healthcheck.js*) echo "healthy: ok" ;;
      *health.json*)
        echo "{\"at\":\"x\",\"activeStreams\":${FAKE_PLAYING:-0},\"discordReady\":true,\"dbOk\":true,\"ffmpegOk\":true}"
        ;;
    esac
    ;;
  cp) dest=${*: -1} && mkdir -p "$dest" && touch "$dest/radio-bot-manual-x.sqlite" ;;
  logs) echo "Fatal: An invalid token was provided." ;;
esac
exit 0
